# DANJER FITNESS - variables para la EC2 en AWS
# En la EC2: cp .env.production.example .env  y completa los valores <...>
# NUNCA subas el .env real a GitHub.

# Hace que "docker compose" use el archivo de producción sin escribir -f
COMPOSE_FILE=docker-compose.prod.yml

APP_NAME="DANJER FITNESS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_URL=https://<tu-dominio>

# Los logs salen por stderr y Docker los envía a CloudWatch (/danjer/laravel)
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Amazon RDS for MySQL (endpoint en RDS > danjer-db > Conectividad y seguridad)
DB_CONNECTION=mysql
DB_HOST=<endpoint-de-rds>.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=danjer
DB_USERNAME=admin
DB_PASSWORD=<contraseña-de-rds>

# Redis corre en el contenedor "redis" de Docker Compose
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

# Amazon S3 - bucket privado para fotos y comprobantes.
# SIN AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY: la EC2 usa el rol IAM
# danjer-ec2-role (hop limit 2 para que lo vean los contenedores).
FILESYSTEM_DISK=s3
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=danjer-prod-media
AWS_USE_PATH_STYLE_ENDPOINT=false

# Correo (completa con tu proveedor SMTP, p. ej. Gmail con contraseña de aplicación)
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<contraseña>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<no-reply@tu-dominio>
MAIL_FROM_NAME="${APP_NAME}"
